/-!
# Statements for the five finite computations

All cases use the same object, morphism, quotient, and path-algebra definitions.
The concrete inputs are `Data.case2`, ..., `Data.case6`; each contains object
labels, cyclic summand lengths, embedding entries, quiver arrows and relations.
An entry `(c,e)` in an embedding means `c * π^e`. Paths list arrows in traversal
order, so a path `[a,b]` evaluates to `φ(b) * φ(a)`.

The elementary ring hypotheses are `RingParameters n R k π ρ`:
* `R` is commutative, `k` is a field, `n > 0`, and `π^n = 0`;
* the ring homomorphism `ρ : R →+* k` is surjective, with kernel `πR`;
* for `l ≤ n`, `π^(n-l) * r = 0` iff `r` is a multiple of `π^l`.
No coefficient-field embedding `k → R` is assumed.

`ObjectFamily.Hom` consists of ambient and source matrices satisfying the
cyclic-module descent equations and the commuting-square equations.
`Dataset.End` is the quotient of all such block endomorphisms by the relation
that `π^(n-1)` annihilates the difference of their ambient maps. Equality in
each `C_l` is expressed by multiplying representatives by `π^(n-l)`.
Its operations are induced by matrix addition and composition; its scalar
action is induced by `ρ`. The shared proofs establish these identifications.

`quiver.PathAlgebra` imposes the vertex and arrow incidence identities.
`quiver.ideal` is the two-sided ideal generated by the listed signed path
relations. `quiver.Presented` imposes those same relations as a ring quotient.
`Dataset.matrix` reads a quotient endomorphism on the free ambient summands;
it is faithful. Vertex and arrow images below are the explicit dataset matrices.

Only the finite algebra computations are asserted. No classification of
indecomposables, Auslander–Reiten translation theorem, or categorical
factorization criterion is a premise or a conclusion of these statements.
-/

noncomputable section
namespace UniserialComputations
open UniserialComputations.Uniform

/-- The same C2 assertion for every dataset: the specified quiver maps onto
its actual annihilation-quotient endomorphism algebra, the listed relation
ideal vanishes, and both algebras have the specified finite dimension. -/
def C2 (D : Dataset) (dimension : Nat) {R k : Type*} [CommRing R] [Field k]
    (π : R) (ρ : R →+* k) (h : RingParameters D.objects.length R k π ρ) : Prop :=
  ∃ φ : D.PathAlgebra k →ₐ[k] D.End k π ρ h,
    (∀ i, D.matrix π ρ h (φ (D.quiver.vertex k i)) = D.vertexMatrix k i) ∧
    (∀ a, D.matrix π ρ h (φ (D.quiver.arrow k a)) = D.arrowValue k a) ∧
    (∀ p ∈ D.quiver.ideal k, φ p = 0) ∧
    Function.Surjective φ ∧
    Module.Finite k (D.Presented k) ∧ Module.Finite k (D.End k π ρ h) ∧
    Module.finrank k (D.Presented k) = dimension ∧
    Module.finrank k (D.End k π ρ h) = dimension

/-- The same C3 assertion for each additional family: every listed object's
individual quotient endomorphism ring is local. The coordinate maps enumerate
exactly its free ambient summands, as checked by `FreeCoordinates`. -/
def C3 (D : ObjectFamily)
    (C : ∀ i : Fin D.vertices, FreeCoordinates (D.singleObject i) (Fin 1))
    {R k : Type*} [CommRing R] [Field k]
    (π : R) (ρ : R →+* k) (h : RingParameters D.length R k π ρ) : Prop :=
  ∀ i : Fin D.vertices, IsLocalRing (EndAlgebra (C i) π ρ h)

variable {R k : Type*} [CommRing R] [Field k] (π : R) (ρ : R →+* k)

/-- C2 for the objects and quiver in `Data.case2`; dimension 6. -/
theorem n2_C2 (h : RingParameters 2 R k π ρ) : C2 Data.case2 6 π ρ h :=
  Uniform.Case2.computation k π ρ h

/-- C2 for the objects and quiver in `Data.case3`; dimension 15. -/
theorem n3_C2 (h : RingParameters 3 R k π ρ) : C2 Data.case3 15 π ρ h :=
  Uniform.Case3.computation k π ρ h

/-- C2 for the objects and quiver in `Data.case4`; dimension 44. -/
theorem n4_C2 (h : RingParameters 4 R k π ρ) : C2 Data.case4 44 π ρ h :=
  Uniform.Case4.computation k π ρ h

/-- C2 for the objects and quiver in `Data.case5`; dimension 179. -/
theorem n5_C2 (h : RingParameters 5 R k π ρ) : C2 Data.case5 179 π ρ h :=
  Uniform.Case5.computation k π ρ h

/-- C2 for the objects and quiver in `Data.case6`; dimension 1708. -/
theorem n6_C2 (h : RingParameters 6 R k π ρ) : C2 Data.case6 1708 π ρ h :=
  Uniform.Case6.computation k π ρ h

/-- C3 for n=2. The additional family is empty. -/
theorem n2_C3 (h : RingParameters 2 R k π ρ) :
    C3 Data.additional2 Data.additionalCoordinates2 π ρ h :=
  fun i => Uniform.oneFree_local (Data.additionalCoordinates2 i) π ρ h

/-- C3 for n=3. The additional family is empty. -/
theorem n3_C3 (h : RingParameters 3 R k π ρ) :
    C3 Data.additional3 Data.additionalCoordinates3 π ρ h :=
  fun i => Uniform.oneFree_local (Data.additionalCoordinates3 i) π ρ h

/-- C3 for n=4. The additional family contains object 26. -/
theorem n4_C3 (h : RingParameters 4 R k π ρ) :
    C3 Data.additional4 Data.additionalCoordinates4 π ρ h :=
  fun i => Uniform.oneFree_local (Data.additionalCoordinates4 i) π ρ h

/-- C3 for n=5. The additional family contains the twelve explicitly listed objects. -/
theorem n5_C3 (h : RingParameters 5 R k π ρ) :
    C3 Data.additional5 Data.additionalCoordinates5 π ρ h :=
  fun i => Uniform.oneFree_local (Data.additionalCoordinates5 i) π ρ h

-- No C3 assertion is made for n=6.
end UniserialComputations
