import UniformOrdinaryEnd
import Mathlib.RingTheory.LocalRing.Basic
import Mathlib.RingTheory.Nilpotent.Basic

/-!
# Locality of ordinary endomorphism rings

The criterion below proves locality by lifting nilpotence of both residue
matrices. It applies to the ordinary ring, with no factorization quotient.
-/

noncomputable section
namespace UniserialComputations.Uniform
universe u v

namespace RingParameters
variable {n : Nat} {R : Type u} {k : Type v} [CommRing R] [Field k]
  {π : R} {ρ : R →+* k} (h : RingParameters n R k π ρ)

include h

theorem nilpotent_of_residue_zero {x : R} (hx : ρ x = 0) : IsNilpotent x := by
  obtain ⟨t, rfl⟩ := (h.residue_kernel x).mp hx
  exact ⟨n, by rw [mul_pow, h.nilpotent, zero_mul]⟩

theorem isUnit_of_residue_ne_zero {x : R} (hx : ρ x ≠ 0) : IsUnit x := by
  obtain ⟨y, hy⟩ := h.residue_surjective (ρ x)⁻¹
  have hz : ρ (1 - x * y) = 0 := by simp [hy, hx]
  have hu := (h.nilpotent_of_residue_zero hz).isUnit_one_sub
  have hxy : IsUnit (x * y) := by simpa only [sub_sub_cancel] using hu
  exact isUnit_of_mul_isUnit_left hxy

/-- Nilpotence lifts from the residue matrix because the scalar kernel is
generated by the nilpotent element `π`. -/
theorem matrix_nilpotent_of_residue {m : Nat} (A : Matrix (Fin m) (Fin m) R)
    (ha : IsNilpotent (A.map ρ)) : IsNilpotent A := by
  obtain ⟨d, hd⟩ := ha
  have hz : ∀ r c, ρ ((A ^ d) r c) = 0 := by
    intro r c
    have H := congrFun (congrFun hd r) c
    simpa only [← Matrix.map_pow, Matrix.map_apply, Matrix.zero_apply] using H
  choose B hB using fun r c => (h.residue_kernel ((A ^ d) r c)).mp (hz r c)
  let C : Matrix (Fin m) (Fin m) R := Matrix.of B
  have he : A ^ d = π • C := by ext r c; exact hB r c
  refine ⟨d * n, ?_⟩
  rw [pow_mul, he, smul_pow, h.nilpotent, zero_smul]
theorem power_zero (d : Nat) (hd : n ≤ d) : π ^ d = 0 := by
  obtain ⟨e, rfl⟩ := Nat.exists_eq_add_of_le hd
  rw [pow_add, h.nilpotent, zero_mul]

theorem residue_zero_of_annihilated {d : Nat} (hd : d < n) {x : R}
    (hx : π ^ d * x = 0) : ρ x = 0 := by
  apply (h.top_annihilator x).mp
  have H := congrArg (fun y : R => π ^ (n - 1 - d) * y) hx
  have hdn : d ≤ n - 1 := by omega
  simpa only [← mul_assoc, ← pow_add, Nat.sub_add_cancel hdn, mul_zero] using H
end RingParameters

/-- Strictly lower triangular finite matrices are nilpotent. -/
theorem matrix_nilpotent_of_strict_lower {S : Type*} [Semiring S] {m : Nat}
    (A : Matrix (Fin m) (Fin m) S) (hA : ∀ r c, r ≤ c → A r c = 0) :
    IsNilpotent A := by
  have hp : ∀ d : Nat, ∀ r c : Fin m, r.val < c.val + d → (A ^ d) r c = 0 := by
    intro d
    induction d with
    | zero =>
      intro r c hrc
      have hne : r ≠ c := by intro e; subst c; omega
      simp [Matrix.one_apply_ne hne]
    | succ d ih =>
      intro r c hrc
      rw [pow_succ, Matrix.mul_apply]
      apply Finset.sum_eq_zero
      intro a _
      by_cases ha : r.val < a.val + d
      · rw [ih r a ha, zero_mul]
      · rw [hA a c (by omega), mul_zero]
  refine ⟨m, ?_⟩
  ext r c
  exact hp m r c (by omega)


namespace ObjectFamily
variable (D : ObjectFamily) {R : Type u} {k : Type v} [CommRing R] [Field k]
  (π : R) (ρ : R →+* k) (h : RingParameters D.length R k π ρ) (i : Fin D.vertices)

/-- Zero rows representing length-zero ambient summands. This changes no
actual module map and is useful for ordinary matrix nilpotence. -/
def normalizeAmbient (f : D.Hom π i i) : D.Hom π i i where
  ambient := Matrix.of (fun r c => if D.ambientLength i r = 0 then 0 else f.ambient r c)
  source := f.source
  ambient_descent := by
    intro r c
    by_cases hr : D.ambientLength i r = 0
    · simp [hr]
    · simpa only [Matrix.of_apply, ite_eq_right hr] using f.ambient_descent r c
  source_descent := f.source_descent
  commutes := by
    intro r c
    by_cases hr : D.ambientLength i r = 0
    · simp [hr, h.nilpotent]
    · simpa only [Matrix.mul_apply, Matrix.of_apply, ite_eq_right hr] using f.commutes r c

theorem ordinaryClass_normalize (f : D.Hom π i i) :
    D.ordinaryClass π ρ h i (D.normalizeAmbient π ρ h i f) =
      D.ordinaryClass π ρ h i f := by
  apply (D.ordinaryClass_eq π ρ h i _ _).mpr
  constructor
  · intro r c
    by_cases hr : D.ambientLength i r = 0
    · simp [normalizeAmbient, hr, h.nilpotent]
    · simp [normalizeAmbient, hr]
  · intro r c
    simp [normalizeAmbient]

@[simp] theorem ordinaryClass_scale (r : R) (f : D.Hom π i i) :
    D.ordinaryClass π ρ h i (Hom.scale D π r f) =
      r • D.ordinaryClass π ρ h i f := rfl

/-- Nilpotence of both residue matrices implies nilpotence of the ordinary
endomorphism. The zero-length ambient rows are discarded only as equal maps. -/
theorem ordinaryClass_nilpotent (f : D.Hom π i i)
    (ha : IsNilpotent ((D.normalizeAmbient π ρ h i f).ambient.map ρ))
    (hs : IsNilpotent (f.source.map ρ)) :
    IsNilpotent (D.ordinaryClass π ρ h i f) := by
  obtain ⟨a, ha⟩ := h.matrix_nilpotent_of_residue _ ha
  obtain ⟨b, hb⟩ := h.matrix_nilpotent_of_residue _ hs
  have hn : IsNilpotent (D.squareOf π ρ h i (D.normalizeAmbient π ρ h i f)) := by
    refine ⟨a + b, Subtype.ext ?_⟩
    apply Prod.ext
    · change (D.normalizeAmbient π ρ h i f).ambient ^ (a + b) = 0
      rw [pow_add, ha, zero_mul]
    · change f.source ^ (a + b) = 0
      rw [pow_add, hb, mul_zero]
  have H := hn.map (D.ordinaryCongruence π ρ h i).mk'
  exact (D.ordinaryClass_normalize π ρ h i f) ▸ H

theorem ordinaryEnd_nontrivial (r : Fin D.ambientSlots)
    (hr : D.ambientLength i r = D.length) : Nontrivial (D.OrdinaryEnd π ρ h i) := by
  apply nontrivial_of_ne (1 : D.OrdinaryEnd π ρ h i) 0
  intro he
  have he' : D.ordinaryClass π ρ h i (Hom.identity D π h i) =
      D.ordinaryClass π ρ h i (Hom.zero D π i i) := he
  have H := ((D.ordinaryClass_eq π ρ h i _ _).mp he').1 r r
  have onezero : (1 : R) = 0 := by simpa [Hom.identity, Hom.zero, hr] using H
  exact (one_ne_zero : (1 : k) ≠ 0) (by simpa using congrArg ρ onezero)

/-- A complete ordinary-locality criterion. All matrix conditions concern
actual commuting-square representatives; the conclusion is locality of the
ordinary endomorphism ring in the monomorphism category. -/
theorem ordinary_local (r : Fin D.ambientSlots)
    (hr : D.ambientLength i r = D.length)
    (nilpotent_residue : ∀ f : D.Hom π i i, ρ (f.ambient r r) = 0 →
      IsNilpotent ((D.normalizeAmbient π ρ h i f).ambient.map ρ) ∧
      IsNilpotent (f.source.map ρ)) :
    IsLocalRing (D.OrdinaryEnd π ρ h i) := by
  have := D.ordinaryEnd_nontrivial π ρ h i r hr
  refine IsLocalRing.of_isUnit_or_isUnit_one_sub_self (R := D.OrdinaryEnd π ρ h i) ?_
  intro x
  obtain ⟨f, rfl⟩ := D.ordinaryClass_surjective π ρ h i x
  by_cases hz : ρ (f.ambient r r) = 0
  · obtain ⟨ha, hs⟩ := nilpotent_residue f hz
    exact Or.inr (D.ordinaryClass_nilpotent π ρ h i f ha hs).isUnit_one_sub
  · let a := f.ambient r r
    let g := Hom.add D π f (Hom.scale D π (-a) (Hom.identity D π h i))
    have hg : ρ (g.ambient r r) = 0 := by simp [g, a, Hom.add, Hom.scale, Hom.identity]
    obtain ⟨ha, hs⟩ := nilpotent_residue g hg
    have hn := D.ordinaryClass_nilpotent π ρ h i g ha hs
    have he : D.ordinaryClass π ρ h i g = D.ordinaryClass π ρ h i f -
        algebraMap R (D.OrdinaryEnd π ρ h i) a := by
      simp [g, Algebra.algebraMap_eq_smul_one, sub_eq_add_neg]
    rw [he] at hn
    have hu : IsUnit (algebraMap R (D.OrdinaryEnd π ρ h i) a) :=
      (h.isUnit_of_residue_ne_zero hz).map (algebraMap R _)
    have hc : Commute (D.ordinaryClass π ρ h i f - algebraMap R _ a)
        (algebraMap R (D.OrdinaryEnd π ρ h i) a) :=
      (Algebra.commutes a _).symm
    exact Or.inl (by simpa only [sub_add_cancel] using hn.isUnit_add_right_of_commute hu hc)

include h in
theorem Hom.ambient_residue_zero (f : D.Hom π i i) (r c : Fin D.ambientSlots)
    (hlt : D.ambientLength i c < D.ambientLength i r) : ρ (f.ambient r c) = 0 := by
  apply h.residue_zero_of_annihilated
    (d := D.length - D.ambientLength i r + D.ambientLength i c)
    (by have := D.ambientBound i r; omega)
  simpa only [pow_add] using f.ambient_descent r c

include h in
theorem Hom.source_residue_zero (f : D.Hom π i i) (r c : Fin D.sourceSlots)
    (hlt : D.sourceLength i c < D.sourceLength i r) : ρ (f.source r c) = 0 := by
  apply h.residue_zero_of_annihilated
    (d := D.length - D.sourceLength i r + D.sourceLength i c)
    (by have := D.sourceBound i r; omega)
  simpa only [pow_add] using f.source_descent r c

/-- For strictly decreasing cyclic lengths, equal diagonal residues in both
matrices give a local ordinary endomorphism ring. Zero-length ambient padding
is allowed and represents the zero module. -/
theorem ordinary_local_of_diagonal_residues (r : Fin D.ambientSlots)
    (hr : D.ambientLength i r = D.length)
    (ha : StrictAnti (D.ambientLength i)) (hs : StrictAnti (D.sourceLength i))
    (diagonal : ∀ f : D.Hom π i i,
      (∀ a, 0 < D.ambientLength i a → ρ (f.ambient a a) = ρ (f.ambient r r)) ∧
      (∀ a, ρ (f.source a a) = ρ (f.ambient r r))) :
    IsLocalRing (D.OrdinaryEnd π ρ h i) := by
  apply D.ordinary_local π ρ h i r hr
  intro f hz
  obtain ⟨da, ds⟩ := diagonal f
  constructor
  · apply matrix_nilpotent_of_strict_lower
    intro a b hab
    simp only [Matrix.map_apply, normalizeAmbient, Matrix.of_apply]
    by_cases hlen : D.ambientLength i a = 0
    · simp [hlen]
    · rw [ite_eq_right hlen]
      rcases lt_or_eq_of_le hab with hlt | rfl
      · exact Hom.ambient_residue_zero D π ρ h i f a b (ha hlt)
      · exact (da a (Nat.pos_of_ne_zero hlen)).trans hz
  · apply matrix_nilpotent_of_strict_lower
    intro a b hab
    change ρ (f.source a b) = 0
    rcases lt_or_eq_of_le hab with hlt | rfl
    · exact Hom.source_residue_zero D π ρ h i f a b (hs hlt)
    · exact (ds a).trans hz

end ObjectFamily
end UniserialComputations.Uniform
