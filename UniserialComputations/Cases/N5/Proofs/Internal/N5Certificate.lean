import N5Presentation
import N5Bridge
import N5C1
import N5C3
noncomputable section
namespace UniserialComputations.N5
variable (k : Type*) [Field k]
/-- The ideal generated by the five zero and five commutativity relations. -/
def relationsIdeal : TwoSidedIdeal (PathAlgebra k) :=
  TwoSidedIdeal.span {z | ∃ x y, Presentation.Relations k x y ∧ z=x-y}
theorem relationsIdeal_vanish : relationsIdeal k ≤ TwoSidedIdeal.ker (pathMap k) := by
  apply TwoSidedIdeal.span_le.mpr
  rintro z ⟨x,y,h,rfl⟩
  apply (TwoSidedIdeal.mem_ker (pathMap k)).mpr
  rw [map_sub,Presentation.respects k h,sub_self]
/-- Final C2 certificate: explicit path evaluation, ideal vanishing, surjectivity,
and equality of the two dimensions. The raw-matrix bridge is verified separately. -/
theorem C2_certificate :
    Function.Surjective (pathMap k) ∧
    (∀ x ∈ relationsIdeal k, pathMap k x=0) ∧
    Module.finrank k (Presentation.Presented k)=179 ∧
    Module.finrank k (End k)=179 := by
  exact ⟨pathMap_surjective k,fun x hx => (TwoSidedIdeal.mem_ker (pathMap k)).mp (relationsIdeal_vanish k hx),
    Presentation.presented_dimension k,end_dimension k⟩
end UniserialComputations.N5
