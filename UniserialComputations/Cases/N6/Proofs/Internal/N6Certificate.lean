import N6Spanning
import N6Surjectivity
noncomputable section
namespace UniserialComputations.N6
namespace Presentation
variable (k : Type*) [Field k]
theorem presented_dimension : Module.finrank k (Presented k)=1708 := by
  apply le_antisymm (presented_dimension_le k)
  have h := LinearMap.finrank_le_finrank_of_surjective (show Function.Surjective (evaluate k).toLinearMap from evaluate_surjective k)
  simpa only [end_finrank] using h
/-- Exactly the two-sided ideal generated by the displayed 47 relations. -/
def relationsIdeal : TwoSidedIdeal (PathAlgebra k) :=
  TwoSidedIdeal.span {z | ∃ x y, Relations k x y ∧ z=x-y}
theorem relationsIdeal_vanish : relationsIdeal k ≤ TwoSidedIdeal.ker (pathMap k) := by
  apply TwoSidedIdeal.span_le.mpr
  rintro z ⟨x,y,h,rfl⟩
  apply (TwoSidedIdeal.mem_ker (pathMap k)).mpr
  rw [map_sub,respects k h,sub_self]
/-- Completed C2 computation. The categorical interpretation remains external input.
No C3 assertion is made for n=6. -/
theorem C2_certificate :
    Function.Surjective (pathMap k) ∧
    (∀ x ∈ relationsIdeal k, pathMap k x=0) ∧
    Module.finrank k (Presented k)=1708 ∧
    Module.finrank k (End k)=1708 := by
  exact ⟨pathMap_surjective k,fun x hx => (TwoSidedIdeal.mem_ker (pathMap k)).mp (relationsIdeal_vanish k hx),presented_dimension k,end_finrank k⟩
end Presentation
end UniserialComputations.N6
