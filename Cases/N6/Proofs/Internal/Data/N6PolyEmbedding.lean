theorem eval_embedding {R : Type*} [CommRing R] (π : R) (h6 : π^6=0) (i : Fin 47) (r : Fin 4) (c : Fin 2) :
 eval6 π (polyEmbedding i r c)=embedding π i r c := by
  fin_cases i <;> fin_cases r <;> fin_cases c
  all_goals simp [polyEmbedding,embedding,eval6_mono π h6,eval6_zero]
end UniserialComputations.N6
